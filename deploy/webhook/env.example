# Copy to deploy/webhook/.env on the server (never commit .env).

# Shared secret — must match GitHub repo webhook settings.
GITHUB_WEBHOOK_SECRET=replace-with-long-random-string

# Where the proxy-list repo is cloned on the server.
WEBHOOK_REPO_ROOT=/home/jason/proxy-list

# HTTP bind (LAN). Expose with Cloudflare Tunnel / reverse proxy for GitHub.
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8787

# Pull latest main before checking; push bot commits after.
WEBHOOK_GIT_PULL=1
WEBHOOK_GIT_PUSH=1

# Optional: Discord incoming webhook URL for run summaries.
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
